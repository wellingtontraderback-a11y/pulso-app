# Supabase (banco de dados + autenticação)
# Pegue esses valores em supabase.com > seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API da Anthropic (geração de treino/dieta por IA) - usada só no servidor
ANTHROPIC_API_KEY=

# Stripe (assinatura) - entram na fase de pagamento
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
